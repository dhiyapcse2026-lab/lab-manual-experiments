#include <iostream>
#include <cassert>
using namespace std;

class Matrix
{
private:
    int data[2][2];

public:
    Matrix(int a = 0, int b = 0, int c = 0, int d = 0)
    {
        data[0][0] = a;
        data[0][1] = b;
        data[1][0] = c;
        data[1][1] = d;
    }

    // Operator +
    Matrix operator+(const Matrix &m)
    {
        Matrix result;
        for (int i = 0; i < 2; i++)
            for (int j = 0; j < 2; j++)
                result.data[i][j] = data[i][j] + m.data[i][j];
        return result;
    }

    // Operator *
    Matrix operator*(const Matrix &m)
    {
        Matrix result;
        for (int i = 0; i < 2; i++)
        {
            for (int j = 0; j < 2; j++)
            {
                result.data[i][j] = 0;
                for (int k = 0; k < 2; k++)
                    result.data[i][j] += data[i][k] * m.data[k][j];
            }
        }
        return result;
    }

    // Operator []
    int* operator[](int index)
    {
        return data[index];
    }

    // Operator <<
    friend ostream& operator<<(ostream &out, const Matrix &m)
    {
        for (int i = 0; i < 2; i++)
        {
            for (int j = 0; j < 2; j++)
                out << m.data[i][j] << " ";

            out << endl;
        }
        return out;
    }
};

int main()
{
    // Original Example
    Matrix A(1, 2, 3, 4);
    Matrix B(5, 6, 7, 8);

    Matrix sum = A + B;
    Matrix product = A * B;

    // Original Unit Tests
    assert(sum[0][0] == 6);
    assert(sum[1][1] == 12);
    assert(product[0][0] == 19);
    assert(product[0][1] == 22);
    assert(product[1][0] == 43);
    assert(product[1][1] == 50);



    cout << "Matrix A:" << endl;
    cout << A;

    cout << "Matrix B:" << endl;
    cout << B;

    cout << "Addition of Matrices:" << endl;
    cout << sum;

    cout << "Multiplication of Matrices:" << endl;
    cout << product;

    // Test Case 1
    Matrix C(2, 3, 4, 5);
    Matrix D(1, 2, 3, 4);

    Matrix sum1 = C + D;
    Matrix product1 = C * D;

    assert(sum1[0][0] == 3);
    assert(sum1[0][1] == 5);
    assert(sum1[1][0] == 7);
    assert(sum1[1][1] == 9);

    assert(product1[0][0] == 11);
    assert(product1[0][1] == 16);
    assert(product1[1][0] == 19);
    assert(product1[1][1] == 28);



    cout << "Matrix C:" << endl;
    cout << C;

    cout << "Matrix D:" << endl;
    cout << D;

    cout << "Addition of Matrices:" << endl;
    cout << sum1;

    cout << "Multiplication of Matrices:" << endl;
    cout << product1;

    cout << "Test Case 1 Passed!" << endl;

    // Test Case 2
    Matrix E(2, 0, 0, 2);
    Matrix F(3, 0, 0, 3);

    Matrix sum2 = E + F;
    Matrix product2 = E * F;

    assert(sum2[0][0] == 5);
    assert(sum2[0][1] == 0);
    assert(sum2[1][0] == 0);
    assert(sum2[1][1] == 5);

    assert(product2[0][0] == 6);
    assert(product2[0][1] == 0);
    assert(product2[1][0] == 0);
    assert(product2[1][1] == 6);



    cout << "Matrix E:" << endl;
    cout << E;

    cout << "Matrix F:" << endl;
    cout << F;

    cout << "Addition of Matrices:" << endl;
    cout << sum2;

    cout << "Multiplication of Matrices:" << endl;
    cout << product2;

    cout << "Test Case 2 Passed!" << endl;

    cout << "\nAll unit tests passed successfully." << endl;

    return 0;
}
