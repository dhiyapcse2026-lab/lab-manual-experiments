#include <iostream>
#include <stack>
#include <queue>
#include <chrono>

using namespace std;
using namespace chrono;

// Custom Stack
template <class T>
class MyStack
{
private:
    T data[10000];
    int top;

public:
    MyStack()
    {
        top = -1;
    }

    void push(T value)
    {
        if (top < 9999)
            data[++top] = value;
    }

    void pop()
    {
        if (top >= 0)
            top--;
    }
};

// Custom Queue
template <class T>
class MyQueue
{
private:
    T data[10000];
    int front, rear;

public:
    MyQueue()
    {
        front = 0;
        rear = -1;
    }

    void enqueue(T value)
    {
        if (rear < 9999)
            data[++rear] = value;
    }

    void dequeue()
    {
        if (front <= rear)
            front++;
    }
};

int main()
{
    int testCases[3] = {3000, 6000, 9000};

    for (int t = 0; t < 3; t++)
    {
        int N = testCases[t];

        cout << "\n--- Test Case " << t + 1
             << " (N = " << N << ") ---" << endl;

        // Custom Stack
        MyStack<int> myStack;

        auto start = high_resolution_clock::now();

        for (int i = 0; i < N; i++)
            myStack.push(i);

        for (int i = 0; i < N; i++)
            myStack.pop();

        auto end = high_resolution_clock::now();

        auto customStackTime =
            duration_cast<microseconds>(end - start);

        // STL Stack
        stack<int> stlStack;

        start = high_resolution_clock::now();

        for (int i = 0; i < N; i++)
            stlStack.push(i);

        for (int i = 0; i < N; i++)
            stlStack.pop();

        end = high_resolution_clock::now();

        auto stlStackTime =
            duration_cast<microseconds>(end - start);

        // Custom Queue
        MyQueue<int> myQueue;

        start = high_resolution_clock::now();

        for (int i = 0; i < N; i++)
            myQueue.enqueue(i);

        for (int i = 0; i < N; i++)
            myQueue.dequeue();

        end = high_resolution_clock::now();

        auto customQueueTime =
            duration_cast<microseconds>(end - start);

        // STL Queue
        queue<int> stlQueue;

        start = high_resolution_clock::now();

        for (int i = 0; i < N; i++)
            stlQueue.push(i);

        for (int i = 0; i < N; i++)
            stlQueue.pop();

        end = high_resolution_clock::now();

        auto stlQueueTime =
            duration_cast<microseconds>(end - start);

        // Display Results
        cout << "Custom Stack Time: "
             << customStackTime.count()
             << " microseconds" << endl;

        cout << "STL Stack Time: "
             << stlStackTime.count()
             << " microseconds" << endl;

        cout << "Custom Queue Time: "
             << customQueueTime.count()
             << " microseconds" << endl;

        cout << "STL Queue Time: "
             << stlQueueTime.count()
             << " microseconds" << endl;
    }

    return 0;
}
