#include <iostream>
using namespace std;

class Student
{
private:
    int rollNo;
    string name;

public:
    // Constructor
    Student(int r, string n)
    {
        rollNo = r;
        name = n;
        cout << "Student object created" << endl;
    }

    // Member function
    void display()
    {
        cout << "Roll Number: " << rollNo << endl;
        cout << "Name: " << name << endl;
    }

    // Destructor
    ~Student()
    {
        cout << "Student object destroyed" << endl;
    }
};

int main()
{
    // Original object
    Student s1(101, "Arun");
    s1.display();

    // Test Case 1
    Student s2(102, "Rahul");
    s2.display();

    // Test Case 2
    Student s3(103, "Priya");
    s3.display();

    return 0;
}
